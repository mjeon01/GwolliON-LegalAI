# 국가법령정보 공동활용에서 신청한 OC 값
legal_api_key=
legal_api_search_url=https://www.law.go.kr/DRF/lawSearch.do
legal_api_service_url=https://www.law.go.kr/DRF/lawService.do

# 선택: 로컬 모델 추출 (기본값)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 선택: 한국어 OCR 언어 모델 폴더 (기본 var/ocr/tessdata)
# GWOLLION_TESSDATA=/absolute/path/to/tessdata
